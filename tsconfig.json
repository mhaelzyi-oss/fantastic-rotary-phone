{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowJs": true,
    "jsx": "react-jsx",
    "types": ["chrome", "vite/client"]
  },
  "include": ["src", "harness", "vite.config.ts", "vite.demo.config.ts", "scripts/web-tools-pack.d.ts", "site/lib/web-tools.d.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "site"]
}
