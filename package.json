{
  "name": "video-pro-finder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first browser media discovery for authorized, non-protected media.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "watch": "vite build --watch",
    "build": "vite build && node scripts/package-extension.js --build-only",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "playwright test",
    "package": "vite build && node scripts/package-extension.js",
    "ci": "npm run format:check && npm run lint && npm test && npm run build && npm run test:e2e && node scripts/package-extension.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@sparticuz/chromium": "^153.0.0",
    "crx3": "^2.0.0",
    "esbuild": "^0.25.10",
    "eslint": "^9.35.0",
    "jest": "^30.1.3",
    "prettier": "^3.6.2",
    "sharp": "^0.35.5",
    "vite": "^6.3.5"
  }
}
