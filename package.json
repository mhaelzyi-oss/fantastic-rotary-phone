{
  "name": "kui-video-extractor",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Extract the public video file from the page.",
  "scripts": {
    "icons": "node scripts/write-icons.mjs",
    "dev": "npm run icons && vite",
    "build": "npm run icons && tsc --noEmit && vite build",
    "lint": "eslint .",
    "pack": "node scripts/pack.mjs",
    "build:firefox": "node scripts/build-firefox.mjs",
    "build:site": "node scripts/build-site.mjs && node scripts/og.mjs",
    "release": "npm run build && npm run pack && npm run build:firefox && npm run build:site",
    "audit:prod": "node scripts/audit-prod.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:real": "node scripts/real-browser.mjs",
    "demo": "vite --config vite.demo.config.ts"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "^0.8.3",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "web-ext": "^10.8.0"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-window": "^1.8.11",
    "zustand": "^4.5.7"
  }
}
